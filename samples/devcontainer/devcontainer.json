// For format details, see https://aka.ms/devcontainers/containers/ruby-rails
{
	"name": "Thecore App",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/app",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"github.github-vscode-theme",
				"henriiik.vscode-sort",
				"karunamurti.haml",
				"iciclesoft.workspacesort",
				"howardzuo.vscode-git-tags",
				"shakram02.bash-beautify",
				"rogalmic.bash-debug",
				"redhat.vscode-yaml",
				"funkyremi.vscode-google-translate",
				"mohd-akram.vscode-html-format",
				"lewisardern.semgrep-snippets",
				"eamodio.gitlens",
				"aliariff.vscode-erb-beautify",
				"GrapeCity.gc-excelviewer",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"jnbt.vscode-rufo",
				"anweber.vscode-httpyac",
				"mhutchie.git-graph",
				"gabrieletassoni.thecore",
				"Shopify.ruby-lsp",
				"Anthropic.claude-code"
			],
			"settings": {
				"rubyLsp.rubyVersionManager": { "identifier": "none" },
				"rubyLsp.formatter": "rubocop_internal",
				"editor.formatOnSave": true,
				"[ruby]": {
					"editor.defaultFormatter": "Shopify.ruby-lsp",
					"editor.formatOnSave": true
				},
				"files.associations": {
					"Gemfile.base": "gemfile",
					"Gemfile.lock": "gemfile"
				}
			}
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/SrzStephen/devcontainer-features/gitlab-cli:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		// Installs the Claude Code CLI and sets up its authentication environment.
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		// Installs graphviz from distro apt repositories (used by `rails g erd:install`).
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "graphviz"
		}
	},

	// The chown is a defensive self-heal: devcontainer features install as
	// root during image build, which can leave gem binstubs under
	// /usr/local/bundle/bin root-owned. That directory has the sticky bit
	// set, so a later `bundle install`/`update` run as vscode gets EPERM
	// trying to overwrite/delete a binstub it doesn't own — even though the
	// directory itself is world-writable.
	//
	// link-host-home.sh aliases the host developer's own home directory name
	// to /home/vscode, so absolute paths Claude Code bakes into its plugin
	// registry under the host username (e.g. /home/<host-user>/.claude/...)
	// still resolve inside the container, where the user is always `vscode`.
	// ${localEnv:USER} is substituted from the HOST environment at
	// container-create time, so this needs no per-developer configuration.
	//
	// Do NOT add `bundle update --bundler` (with no version) here. Bare
	// `--bundler` makes Bundler's own SelfManager#find_latest_matching_spec
	// query rubygems.org live, at container-create time, and pick the highest
	// Gem::Version that exists there — with NO prerelease filtering (unlike
	// plain `gem`/`bundle install` dependency resolution). Whatever the image
	// ships with is irrelevant; this re-fetches "latest, prereleases included"
	// on every single rebuild, and can silently rewrite Gemfile.lock's
	// BUNDLED WITH to a prerelease. If bundler needs bumping, pin an explicit
	// non-prerelease version at the call site (`bundle update --bundler
	// X.Y.Z`) and update it deliberately — never leave `--bundler` bare.
	"postCreateCommand": "sudo chown -R vscode:vscode /usr/local/bundle && bundle update && bash .devcontainer/link-host-home.sh '${localEnv:USER}' && bash .devcontainer/check-plugins.sh",

	// Persist host-side auth so bundler/gem and Claude Code don't need
	// re-authentication after every container rebuild. The gh/glab CLI config
	// mounts below are commented out by default — uncomment whichever one(s)
	// you already have configured on your host OS to reuse that auth inside
	// the container instead of authenticating again from scratch.
	"mounts": [
		// "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
		// "source=${localEnv:HOME}/.config/glab-cli,target=/home/vscode/.config/glab-cli,type=bind",
		"source=${localEnv:HOME}/.bundle,target=/home/vscode/.bundle,type=bind",
		"source=${localEnv:HOME}/.gem,target=/home/vscode/.gem,type=bind",
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
		"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind"
	],

	"remoteUser": "vscode"
}
